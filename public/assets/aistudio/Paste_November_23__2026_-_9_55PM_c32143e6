  <script>
    function setExhibitionMode(mode) {
      const isLive = mode === 'live';
      document.getElementById('ex-btn-live').className = isLive
        ? 'px-gutter-sm py-1 rounded-full bg-light-primary text-light-on-primary clay-btn-primary font-label text-label-sm shrink-0'
        : 'px-gutter-sm py-1 rounded-full bg-light-surface-container text-light-on-surface-variant font-label text-label-sm shrink-0';
      document.getElementById('ex-btn-alert').className = !isLive
        ? 'px-gutter-sm py-1 rounded-full bg-light-primary text-light-on-primary clay-btn-primary font-label text-label-sm shrink-0'
        : 'px-gutter-sm py-1 rounded-full bg-light-surface-container text-light-on-surface-variant font-label text-label-sm shrink-0';

      document.getElementById('demo-disclaimer').classList.toggle('hidden', isLive);
      const modeBadge = document.getElementById('mode-badge');
      modeBadge.innerHTML = isLive ? '<span class="font-label text-label-sm">LIVE DATA</span>' : '<span class="font-label text-label-sm">DEMO DATA</span>';
      modeBadge.className = isLive
        ? 'inline-flex items-center gap-gutter-xs px-gutter-sm py-gutter-xs rounded-full bg-success-container text-on-success-container'
        : 'inline-flex items-center gap-gutter-xs px-gutter-sm py-gutter-xs rounded-full bg-warning-container text-on-warning-container';

      // Moisture
      document.getElementById('m-value').textContent = isLive ? '44%' : '24%';
      document.getElementById('m-bar').style.width = isLive ? '44%' : '24%';
      document.getElementById('m-status-pill').textContent = isLive ? 'Suitable' : 'Low';
      document.getElementById('m-status-pill').className = isLive
        ? 'px-gutter-sm py-gutter-xs rounded-full bg-success-container text-on-success-container font-label text-label-sm'
        : 'px-gutter-sm py-gutter-xs rounded-full bg-warning-container text-on-warning-container font-label text-label-sm';
      document.getElementById('m-alert-box').className = isLive
        ? 'p-gutter-sm rounded bg-light-surface-container-low text-light-on-surface-variant font-body text-body-sm'
        : 'p-gutter-sm rounded bg-warning-container text-on-warning-container font-body text-body-sm';
      document.getElementById('m-alert-title').textContent = isLive ? 'Within crop range' : 'Alert: Below 38% threshold';
      document.getElementById('m-next-step').textContent = isLive ? 'Next: Check again tomorrow morning.' : 'Next: Check another plot spot & plan irrigation.';

      // pH
      document.getElementById('ph-value').textContent = isLive ? '6.4' : '7.9';
      document.getElementById('ph-marker').style.left = isLive ? '46%' : '76%';
      document.getElementById('ph-status-pill').textContent = isLive ? 'Near Neutral' : 'Alkaline';
      document.getElementById('ph-status-pill').className = isLive
        ? 'px-gutter-sm py-gutter-xs rounded-full bg-success-container text-on-success-container font-label text-label-sm'
        : 'px-gutter-sm py-gutter-xs rounded-full bg-warning-container text-on-warning-container font-label text-label-sm';
      document.getElementById('ph-alert-box').className = isLive
        ? 'p-gutter-sm rounded bg-light-surface-container-low text-light-on-surface-variant font-body text-body-sm'
        : 'p-gutter-sm rounded bg-warning-container text-on-warning-container font-body text-body-sm';
      document.getElementById('ph-alert-title').textContent = isLive ? 'Balanced for paddy' : 'Alert: Above preferred 5.5–7.0 range';
      document.getElementById('ph-next-step').textContent = isLive ? 'Next: No pH amendment needed today.' : 'Next: Review a soil test before choosing an amendment.';

      // Temperature
      document.getElementById('t-value').textContent = isLive ? '26.8°C' : '31.4°C';
      document.getElementById('t-bar').style.width = isLive ? '54%' : '78%';
      document.getElementById('t-status-pill').textContent = isLive ? 'Optimal' : 'Warm';
      document.getElementById('t-desc').textContent = isLive
        ? 'Supports steady root activity without midday heat stress.'
        : 'Higher surface warmth; organic mulch can help shade roots.';

      // Today's Soil Advice
      document.getElementById('advice-text').textContent = isLive
        ? "Moisture (44%) and pH (6.4) are within your Paddy crop's preferred range. Keep monitoring morning probe readings before scheduling irrigation."
        : "Soil moisture (24%) is below your selected crop's threshold and pH (7.9) is above its preferred range. Check another area of the plot and review a reliable soil test before choosing an amendment.";
    }
  </script>


</body></html>